<Window
    x:Class="TanukiTag.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TanukiTag"
    xmlns:models="using:TanukiTag.Models"
    xmlns:services="using:TanukiTag.Services">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          PointerPressed="RootGrid_PointerPressed"
          AllowDrop="True"
          DragEnter="RootGrid_DragEnter"
          DragLeave="RootGrid_DragLeave">
        <Grid.Resources>
            <!-- サムネイル未生成/失敗時に見える背景色。ApplyTheme() でテーマに合わせて更新される。 -->
            <SolidColorBrush x:Key="ThumbCellBackgroundBrush" Color="#3A3A3A" />

            <!-- タグリストのタグ数チップの背景。以前は固定で白の20%透過(#33FFFFFF)だったため、
                 明るいテーマでは背景に馴染んで見えにくかった。ApplyTheme()でテーマの文字色(Fg)を
                 基準にした薄い塗りへ都度更新することで、テーマによらず視認できるようにする。 -->
            <SolidColorBrush x:Key="TagCountChipBackgroundBrush" Color="#08FFFFFF" />

            <!-- 左サイドバー（FilterListView・TagListView）のListViewItemの選択色/ホバー色。
                 既定のWinUI標準スタイルはアクセント色そのままで濃く目立ちすぎるため、
                 エクスプローラーの左ツリーのような薄い色合いに上書きする。
                 これらのキー名はListViewItemの既定コントロールテンプレートが参照している
                 ThemeResourceと同じ名前で、ここで定義すると（ThemeResourceの解決は
                 要素ツリーを上に辿って探すため）標準の配色より優先して使われる。
                 実際の色はApplyTheme()でテーマのSel色から都度更新される。 -->
            <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#330078D4" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#500078D4" />
            <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPressed" Color="#600078D4" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#1A0078D4" />
            <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#2A0078D4" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 設定ボタン以外のツールバー項目。ウィンドウを狭めた際は右端の設定ボタンと
                 重ならないよう、はみ出た分をこのScrollViewer内で横スクロールさせる
                 （Grid列いっぱいでクリップされるだけで、右端の設定ボタンは常に表示され続ける）。 -->
            <ScrollViewer Grid.Column="0" HorizontalScrollMode="Auto"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button x:Name="OpenFolderButton" Click="OpenFolderButton_Click"
                            ToolTipService.ToolTip="フォルダを開く">
                        <FontIcon Glyph="&#xE8B7;" FontSize="16" />
                    </Button>
                    <TextBlock Text="並替:" VerticalAlignment="Center" Opacity="0.8" />
                    <ComboBox x:Name="SortComboBox" VerticalAlignment="Center" Width="160"
                              SelectionChanged="SortComboBox_SelectionChanged" />
                    <TextBlock Text="🔍" VerticalAlignment="Center" Opacity="0.8" />
                    <TextBox x:Name="SearchTextBox" VerticalAlignment="Center" Width="220"
                             PlaceholderText="ファイル名・コメントで検索"
                             TextChanged="SearchTextBox_TextChanged" />
                    <TextBlock Text="表示サイズ:" VerticalAlignment="Center" Opacity="0.8" />
                    <Slider x:Name="ThumbGridSizeSlider" VerticalAlignment="Center" Width="140"
                            Minimum="80" Maximum="320"
                            Value="{x:Bind services:UiSettings.Instance.ThumbCellSize, Mode=TwoWay}"
                            ValueChanged="ThumbGridSizeSlider_ValueChanged" />
                </StackPanel>
            </ScrollViewer>

            <!-- 設定ボタンは常に右端固定。上のScrollViewerとは別Gridセル(Auto幅)に
                 置くことで、ウィンドウをどれだけ小さくしても隠れたりはみ出したりしない。 -->
            <Button x:Name="SettingsButton" Grid.Column="1" Click="SettingsButton_Click"
                    Margin="12,0,0,0" VerticalAlignment="Center"
                    ToolTipService.ToolTip="設定">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="220" MinWidth="140" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ── 左サイドバー: フィルタ + タグ一覧 + タグ付けUI ── -->
            <Grid x:Name="SidebarGrid" Grid.Column="0" Padding="8" RowDefinitions="Auto,*,Auto">

                <ListView x:Name="FilterListView" Grid.Row="0"
                          SelectionMode="Single"
                          SelectionChanged="FilterListView_SelectionChanged"
                          Padding="0"
                          Margin="0,0,0,4">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="8,2" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListViewItem Content="すべてのファイル" Tag="all" />
                    <ListViewItem Content="よく使うファイル" Tag="most_opened" />
                    <ListViewItem Content="スター" Tag="starred" />
                    <ListViewItem Content="最近開いたファイル" Tag="recent" />
                </ListView>

                <ListView x:Name="TagListView" Grid.Row="1"
                          SelectionMode="Extended"
                          SelectionChanged="TagListView_SelectionChanged"
                          RightTapped="TagListView_RightTapped"
                          DoubleTapped="TagListView_DoubleTapped"
                          CanDragItems="True"
                          DragItemsStarting="TagListView_DragItemsStarting"
                          ItemsSource="{x:Bind NavRows, Mode=OneWay}">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="8,4" />
                            <Setter Property="MinHeight" Value="0" />
                            <!-- 既定はHorizontalContentAlignment="Left"のため、行の中身(Grid)が
                                 ラベルの文字幅ぶんしか広がらず、Width="*"のラベル列が
                                 残り幅を持てずタグ数チップが文字のすぐ右に来てしまっていた。
                                 Stretchにして行を領域いっぱいに広げることで、ラベル列(*)が
                                 残り幅を占め、チップ列(Auto)が常に右端に固定されるようにする。 -->
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:NavRow">
                            <Grid Margin="{x:Bind Indent}" HorizontalAlignment="Stretch">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind CollapseGlyph}"
                                           Visibility="{x:Bind GlyphVisibility}"
                                           FontSize="10" VerticalAlignment="Center" />
                                <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5"
                                        Background="{x:Bind ColorBrush}"
                                        Visibility="{x:Bind DotVisibility}" />
                                <FontIcon Grid.Column="0" Glyph="&#xE8B7;" FontSize="12"
                                          Visibility="{x:Bind FolderGlyphVisibility}"
                                          Foreground="#DCB35C"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Label}"
                                           FontWeight="{x:Bind LabelWeight}"
                                           FontSize="{x:Bind services:UiSettings.Instance.TagListFontSize, Mode=OneWay}"
                                           FontFamily="{x:Bind services:UiSettings.Instance.TagFontFamily, Mode=OneWay}"
                                           Margin="3,0,0,0" VerticalAlignment="Center" />
                                <!-- タグの付与件数チップ。数字のみを右詰めで表示する（"(件数)"のような
                                     カッコ書きは付けない）。 -->
                                <Border Grid.Column="2" Visibility="{x:Bind CountVisibility}"
                                        Background="{StaticResource TagCountChipBackgroundBrush}" CornerRadius="6" Padding="6,1"
                                        Margin="4,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        MinWidth="20">
                                    <TextBlock Text="{x:Bind CountText}"
                                               FontSize="{x:Bind services:UiSettings.Instance.TagListFontSize, Mode=OneWay}"
                                               HorizontalAlignment="Right" Opacity="0.85" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- TagListViewの上に重ねる透明なドロップ受け皿。既定は非表示（IsHitTestVisible=False）で、
                     通常のクリック・右クリックには一切影響しない。ウィンドウ全体へのドラッグ開始
                     （RootGrid_DragEnter）でのみ一時的に有効化し、ドラッグ終了で無効化する。
                     TagListView自体にAllowDrop/DragOverを付けると、内部のScrollViewerがDragOverを
                     先取りして既定の自動スクロール（感度を調整できず、常に速い）を行ってしまうため、
                     ドラッグ中だけこちらでイベントを受けて、狭いゾーン・低速な自動スクロールと
                     ホバー中タグのチップ表示を自前で行う。 -->
                <Border x:Name="TagDropOverlay" Grid.Row="1" Background="Transparent"
                        IsHitTestVisible="False"
                        AllowDrop="True"
                        DragEnter="TagDropOverlay_DragEnter"
                        DragOver="TagDropOverlay_DragOver"
                        DragLeave="TagDropOverlay_DragLeave"
                        Drop="TagDropOverlay_Drop" />

                <!-- タグ・フォルダが1件も登録されていない起動直後だけ、TagListViewの空欄に
                     使い方の説明を重ねて表示する。以前は下の「タグ+」ボタン上に固定表示していたが、
                     タグ・フォルダを登録した後もずっと表示され続けて場所を取っていたため、
                     ここでは空欄の間だけ出す一時的なヒントに変更した。
                     NavRows.Countの変化（ObservableCollectionが内部でCount変更を通知する）に
                     x:Bindのメソッド呼び出しで反応させ、1件でも増えたら自動で消える。
                     IsHitTestVisible="False"でTagListViewへのドラッグ&ドロップ（フォルダ登録）を妨げない。 -->
                <TextBlock Grid.Row="1"
                           Text="① 右のグリッドでファイルをクリックして選択（Ctrl/Shiftクリックやドラッグ範囲選択で複数選択も可能）&#x0a;② 上のタグ一覧はCtrl/Shiftクリックで複数のタグ・フォルダを選択できます&#x0a;③ タグ名を入力して「タグ+」でタグを追加、「グループ+」でグループを作成できます&#x0a;④ フォルダはここへドラッグ&amp;ドロップして登録できます"
                           Visibility="{x:Bind EmptyNavHintVisibility(NavRows.Count), Mode=OneWay}"
                           IsHitTestVisible="False"
                           FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                           Margin="4,4,4,0" VerticalAlignment="Top" />

                <StackPanel Grid.Row="2" Spacing="6" Margin="0,8,0,0">
                    <TextBox x:Name="NewTagTextBox" PlaceholderText="タグ名を入力"
                             Visibility="Collapsed" KeyDown="NewTagTextBox_KeyDown" />
                    <TextBox x:Name="NewGroupTextBox" PlaceholderText="グループ名を入力"
                             Visibility="Collapsed" KeyDown="NewGroupTextBox_KeyDown" />
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="AddTagButton" Grid.Column="0" Content="タグ+" Click="AddTagButton_Click"
                                HorizontalAlignment="Stretch" />
                        <Button x:Name="AddGroupButton" Grid.Column="1" Content="グループ+" Click="AddGroupButton_Click"
                                HorizontalAlignment="Stretch" />
                    </Grid>
                    <TextBlock x:Name="TagActionStatusText" FontSize="12" Opacity="0.8"
                               TextWrapping="Wrap" Foreground="{ThemeResource SystemAccentColor}" />
                </StackPanel>
            </Grid>

            <!-- ── サイドバーとサムネイルグリッドの間のドラッグ可能な区切り線 ── -->
            <Border x:Name="SidebarSplitter" Grid.Column="1" Width="6"
                    Background="Transparent"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    PointerPressed="SidebarSplitter_PointerPressed"
                    PointerMoved="SidebarSplitter_PointerMoved"
                    PointerReleased="SidebarSplitter_PointerReleased"
                    PointerCaptureLost="SidebarSplitter_PointerReleased">
                <Grid>
                    <Border x:Name="SidebarSplitterBar" Width="1" HorizontalAlignment="Center"
                            Background="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    <!-- 掴む位置が分かりやすいよう、縦中央に小さな丸3つ縦並びのグリップを表示する。
                         幅調整可能なことに気づきにくい、というフィードバックへの対応。 -->
                    <Border x:Name="SidebarSplitterGrip"
                            Width="14" Height="36" CornerRadius="7"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            IsHitTestVisible="False">
                        <StackPanel Orientation="Vertical" Spacing="3"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="3" Height="3" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Ellipse Width="3" Height="3" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Ellipse Width="3" Height="3" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ── 右側: サムネイルグリッド（+ ラバーバンド選択オーバーレイ） ── -->
            <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Python版タグファイラーと同様、現在表示中のフォルダ/タグ名と件数を
                 グリッドのすぐ上の専用エリアに表示する（以前はツールバー右端にあった）。 -->
            <Border Grid.Row="0" Padding="8,4" BorderThickness="0,0,0,1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <!-- フォルダ表示中のみ意味を持つナビゲーション（戻る/進む/上へ）。
                         タグ/フィルタ表示中は無効化する（Enabledバインドは各ハンドラ側の
                         コードビハインドから明示的に更新する）。 -->
                    <Button x:Name="FolderBackButton" Click="FolderBackButton_Click"
                            IsEnabled="False" Padding="6,4" VerticalAlignment="Center"
                            ToolTipService.ToolTip="戻る">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    </Button>
                    <Button x:Name="FolderForwardButton" Click="FolderForwardButton_Click"
                            IsEnabled="False" Padding="6,4" VerticalAlignment="Center"
                            ToolTipService.ToolTip="進む">
                        <FontIcon Glyph="&#xE72A;" FontSize="14" />
                    </Button>
                    <Button x:Name="FolderUpButton" Click="FolderUpButton_Click"
                            IsEnabled="False" Padding="6,4" VerticalAlignment="Center"
                            ToolTipService.ToolTip="上のフォルダへ">
                        <FontIcon Glyph="&#xE74A;" FontSize="14" />
                    </Button>
                    <Button x:Name="SelectAllButton" Click="SelectAllButton_Click"
                            Padding="6,4" VerticalAlignment="Center"
                            ToolTipService.ToolTip="すべて選択">
                        <FontIcon Glyph="&#xE8B3;" FontSize="14" />
                    </Button>
                    <Button x:Name="BulkTagButton" Click="BulkTagButton_Click"
                            Padding="6,4" VerticalAlignment="Center"
                            ToolTipService.ToolTip="表示中のファイルすべてにタグ付け">
                        <FontIcon Glyph="&#xE8EC;" FontSize="14" />
                    </Button>
                    <TextBlock x:Name="StatusText" Text="フォルダ未選択"
                               FontSize="{x:Bind services:UiSettings.Instance.FileListFontSize, Mode=OneWay}"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <GridView x:Name="ThumbGridView"
                      Grid.Row="1"
                      Background="Transparent"
                      Loaded="ThumbGridView_Loaded"
                      ScrollViewer.VerticalScrollBarVisibility="Hidden"
                      ScrollViewer.VerticalScrollMode="Enabled"
                      SelectionMode="Extended"
                      IsItemClickEnabled="False"
                      CanDragItems="True"
                      AllowDrop="True"
                      DragItemsStarting="ThumbGridView_DragItemsStarting"
                      DragOver="ThumbGridView_DragOver"
                      Drop="ThumbGridView_Drop"
                      ContainerContentChanging="ThumbGridView_ContainerContentChanging"
                      Tapped="ThumbGridView_Tapped"
                      DoubleTapped="ThumbGridView_DoubleTapped"
                      RightTapped="ThumbGridView_RightTapped"
                      PointerWheelChanged="ThumbGridView_PointerWheelChanged"
                      PointerPressed="ThumbGridView_PointerPressed"
                      PointerMoved="ThumbGridView_PointerMoved"
                      PointerReleased="ThumbGridView_PointerReleased"
                      PointerCaptureLost="ThumbGridView_PointerReleased"
                      Padding="8">
                <!-- サムネイル一覧のホバー/選択色。左サイドバー(ListView)と同じキー名を
                     ここでも定義することで、GridView配下だけこちらの色が優先され
                     (ThemeResourceの解決は要素ツリーを上に辿るため、より内側の
                     この定義がRootGrid.Resourcesのものより先に見つかる)、左サイドバーの
                     ホバー色には影響しない。実際の色はApplyTheme()でテーマに応じて
                     都度更新される（ダークテーマではっきり見えるよう、左サイドバーより
                     明るめ・不透明度高めにする）。 -->
                <GridView.Resources>
                    <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="#4D0078D4" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelectedPointerOver" Color="#800078D4" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundSelected" Color="#600078D4" />
                    <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="#5A0078D4" />
                </GridView.Resources>
                <!-- 既定のGridViewは、ItemsSourceの差し替え/再アタッチのたびにアイテムを
                     フェード＋拡大しながら1つずつ「ポップイン」させる登場アニメーション
                     (EntranceThemeTransition等)を自動で付与する。LoadRecordsIntoGridは
                     ItemsSourceを一旦nullにしてから再アタッチする方式のため、切替のたびに
                     このポップインが目立ってしまい、サムネの読み込み自体を先読みしても
                     「一瞬消えてから浮き出るように出てくる」ように見える原因になっていた。
                     ItemContainerTransitionsを空にして、この登場アニメーションを止める。 -->
                <GridView.ItemContainerTransitions>
                    <TransitionCollection />
                </GridView.ItemContainerTransitions>
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:FileItem">
                        <Grid Width="{x:Bind services:UiSettings.Instance.ThumbCellWidth, Mode=OneWay}"
                              Margin="{x:Bind services:UiSettings.Instance.GridItemMargin, Mode=OneWay}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Height="{x:Bind services:UiSettings.Instance.ThumbCellHeight, Mode=OneWay}"
                                    Background="{StaticResource ThumbCellBackgroundBrush}" CornerRadius="4">
                                <Grid>
                                    <!-- 汎用アイコン(FontIcon)を先に描画し、その上にThumbImageを重ねる。
                                         画像/動画/アーカイブ以外の一般ファイルは、シェルAPIで取得した
                                         実際のファイルアイコンがThumbImageに読み込まれるとこちらは隠れ、
                                         万一取得に失敗した場合だけこの汎用アイコンが見える形になる。 -->
                                    <FontIcon Glyph="&#xE8B7;"
                                              Visibility="{x:Bind IsFolder, Mode=OneWay}"
                                              FontSize="40"
                                              Foreground="#DCB35C"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <FontIcon Glyph="&#xE7C3;"
                                              Visibility="{x:Bind IsOtherFile, Mode=OneWay}"
                                              FontSize="40"
                                              Foreground="#888888"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image x:Name="ThumbImage"
                                           Stretch="Uniform"
                                           Width="{x:Bind services:UiSettings.Instance.ThumbCellWidth, Mode=OneWay}"
                                           Height="{x:Bind services:UiSettings.Instance.ThumbCellHeight, Mode=OneWay}" />
                                    <!-- スター単体だと明るいサムネの上で背景に埋もれて見にくいことがあるため、
                                         同じ書体のグリフを黒色で1px四方にずらして4枚重ねて縁取りに見せかけ、
                                         最後に本来のGold色のグリフを重ねる（WinUIにはテキストの
                                         ストローク描画が無いための代替策）。 -->
                                    <Grid Visibility="{x:Bind services:UiSettings.Instance.ShowStar, Mode=OneWay}">
                                        <TextBlock Text="{x:Bind StarGlyph, Mode=OneWay}"
                                                   Foreground="Black" FontSize="16"
                                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                                   Margin="0,1,4,0" />
                                        <TextBlock Text="{x:Bind StarGlyph, Mode=OneWay}"
                                                   Foreground="Black" FontSize="16"
                                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                                   Margin="0,3,4,0" />
                                        <TextBlock Text="{x:Bind StarGlyph, Mode=OneWay}"
                                                   Foreground="Black" FontSize="16"
                                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                                   Margin="1,2,3,0" />
                                        <TextBlock Text="{x:Bind StarGlyph, Mode=OneWay}"
                                                   Foreground="Black" FontSize="16"
                                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                                   Margin="-1,2,5,0" />
                                        <TextBlock Text="{x:Bind StarGlyph, Mode=OneWay}"
                                                   Foreground="Gold" FontSize="16"
                                                   HorizontalAlignment="Right" VerticalAlignment="Top"
                                                   Margin="0,2,4,0" />
                                    </Grid>
                                    <Border Background="#DDADD8E6" CornerRadius="4"
                                            Padding="5,1" Margin="4,2,0,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Top"
                                            Visibility="{x:Bind services:UiSettings.Instance.ShowOpenCountBadge, Mode=OneWay}">
                                        <TextBlock Text="{x:Bind OpenCountGlyph, Mode=OneWay}"
                                                   Foreground="#1A3A5C" FontSize="12" />
                                    </Border>
                                </Grid>
                            </Border>
                            <TextBlock Grid.Row="1"
                                       Text="{x:Bind DisplayName, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Top"
                                       FontSize="{x:Bind services:UiSettings.Instance.FileListFontSize, Mode=OneWay}"
                                       FontFamily="{x:Bind services:UiSettings.Instance.NameFontFamily, Mode=OneWay}"
                                       FontWeight="{x:Bind services:UiSettings.Instance.NameFontWeight, Mode=OneWay}"
                                       Margin="0,0,0,0" />
                            <Border Grid.Row="2"
                                    Height="{x:Bind services:UiSettings.Instance.TagsAreaHeight, Mode=OneWay}"
                                    Margin="{x:Bind services:UiSettings.Instance.TagsAreaOverlapMargin, Mode=OneWay}"
                                    HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Canvas.ZIndex="1">
                                <!-- タグチップサイズ「小」、または「2列表示」オプションの時にTags2にも
                                     中身が入り2行表示になる。「2列表示」時はTagsAreaOverlapMarginが
                                     負の上マージンになり、1行の基準高さを超える分（2行目のはみ出し分）を
                                     このBorderごと上へずらしてファイル名の下端に重ねて表示する
                                     （Grid.Row=2自体の確保高さは変えないため、下の項目の位置には
                                     影響しない）。それ以外は常に空(高さ0)のままなので、Spacing=0で
                                     ファイル名のすぐ下に隙間なく重なる位置に来る。 -->
                                <StackPanel Orientation="Vertical" Spacing="0"
                                            VerticalAlignment="Top">
                                    <ItemsControl ItemsSource="{x:Bind Tags}"
                                                  HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <!-- 左詰め・重ならない固定の隙間(ChipGap)で配置する。
                                                     収まる件数の選定はSetItemTags/SelectFittingTags側で行う。 -->
                                                <StackPanel Orientation="Horizontal" Spacing="0" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:TagChip">
                                                <Border Background="{x:Bind Background}"
                                                        CornerRadius="6" Padding="5,0"
                                                        Margin="{x:Bind Margin}">
                                                    <!-- タグフォント設定（TagFontFamily/TagFontWeight）は左側タブリスト専用にし、
                                                         ファイル下のタグチップは既定フォントのまま変えない。 -->
                                                    <TextBlock Text="{x:Bind DisplayName}"
                                                               Foreground="{x:Bind Foreground}"
                                                               FontSize="{x:Bind services:UiSettings.Instance.FileListTagsFontSize, Mode=OneWay}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{x:Bind Tags2}"
                                                  HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="0" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:TagChip">
                                                <Border Background="{x:Bind Background}"
                                                        CornerRadius="6" Padding="5,0"
                                                        Margin="{x:Bind Margin}">
                                                    <!-- タグフォント設定（TagFontFamily/TagFontWeight）は左側タブリスト専用にし、
                                                         ファイル下のタグチップは既定フォントのまま変えない。 -->
                                                    <TextBlock Text="{x:Bind DisplayName}"
                                                               Foreground="{x:Bind Foreground}"
                                                               FontSize="{x:Bind services:UiSettings.Instance.FileListTagsFontSize, Mode=OneWay}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- ファイル一覧が空の時だけ表示する操作ガイド。ThumbGridViewと同じGrid.Row="1"に重ねて
                 配置し、IsHitTestVisible="False"でポインター操作（ドラッグ＆ドロップ含む）は
                 下のThumbGridViewへそのまま通す。表示/非表示はコードビハインド側で
                 ThumbGridViewの中身の有無に応じて切り替える（UpdateEmptyStateHint参照）。 -->
            <StackPanel x:Name="EmptyStateHint" Grid.Row="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False" Spacing="10" Visibility="Collapsed">
                <FontIcon Glyph="&#xE838;" FontSize="40" Opacity="0.35" HorizontalAlignment="Center" />
                <TextBlock Text="ここへドラッグ＆ドロップでフォルダを開く"
                           FontSize="16" Opacity="0.55" HorizontalAlignment="Center" />
                <TextBlock Text="ファイルをファイルエリアに開くとタグ付けできます"
                           FontSize="13" Opacity="0.4" HorizontalAlignment="Center" />
            </StackPanel>
            <Canvas x:Name="RubberBandCanvas" Grid.Row="1" IsHitTestVisible="False">
                <Rectangle x:Name="RubberBandRect" Visibility="Collapsed"
                           Fill="#400078D4" Stroke="#0078D4" StrokeThickness="1" />
            </Canvas>

            <!-- ── 自前の縦スクロールバー ──────────────────────────────
                 WinUI3既定のScrollBarは「マウスが近づいた時だけ太くなる」挙動を内部で
                 常に再適用してしまい、外部から状態を固定できない。
                 そのため既定のScrollBarは非表示にし(上のScrollViewer.VerticalScrollBarVisibility="Hidden")、
                 代わりにここで自前のトラック/つまみを描画して常に太い状態を維持する。 -->
            <Canvas x:Name="CustomVScrollTrack"
                    Grid.Row="1"
                    Width="{StaticResource ScrollBarSize}"
                    HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    Background="Transparent"
                    PointerPressed="CustomVScrollTrack_PointerPressed">
                <Border x:Name="CustomVScrollThumb"
                        Width="{StaticResource ScrollBarSize}"
                        CornerRadius="3"
                        Background="#66808080"
                        Visibility="Collapsed"
                        PointerEntered="CustomVScrollThumb_PointerEntered"
                        PointerExited="CustomVScrollThumb_PointerExited"
                        PointerPressed="CustomVScrollThumb_PointerPressed"
                        PointerMoved="CustomVScrollThumb_PointerMoved"
                        PointerReleased="CustomVScrollThumb_PointerReleased"
                        PointerCaptureLost="CustomVScrollThumb_PointerReleased" />
            </Canvas>
            </Grid>
        </Grid>

        <!-- タグへドラッグ中、マウスカーソル付近にホバー中のタグ名を表示するチップ。
             RootGrid直下（Grid.RowSpan="2"）に置くことで、DragEventArgs.GetPosition(null)と
             同じウィンドウ座標系でCanvas.Left/Topを指定できる。 -->
        <Canvas x:Name="TagHoverChipCanvas" Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False">
            <Border x:Name="TagHoverChip" Visibility="Collapsed"
                    Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}"
                    BorderBrush="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="8,4">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Border x:Name="TagHoverChipDot" Width="8" Height="8" CornerRadius="4"
                            VerticalAlignment="Center" Visibility="Collapsed" />
                    <TextBlock x:Name="TagHoverChipText" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</Window>
